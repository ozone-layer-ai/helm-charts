{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 0,
  "links": [],
  "panels": [
    {
      "title": "Log Volume",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=~\".+\", namespace=~\"$namespace\", level=~\"$level\", level!=\"\"} [$__auto]))",
          "legendFormat": "{{ level }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=~\".+\", namespace=~\"$namespace\", level=~\"error|critical\"} [$__auto]))",
          "legendFormat": "{{ level }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "Top Logging Pods",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "topk(10, sum by (pod) (count_over_time({job=~\".+\", namespace=~\"$namespace\", pod!=\"\"} [$__range])))",
          "instant": true,
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "pod" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "light-blue" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Value.*" },
            "properties": [
              { "id": "displayName", "value": "Log Count" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "light-orange" }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Log Count", "desc": true }],
        "header": {
          "showHeader": true,
          "options": {
            "fontWeight": "bold"
          }
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "Value", "desc": true }] }
        }
      ]
    },
    {
      "title": "Top Logging Pods",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 },
      "targets": [
        {
          "expr": "topk(10, sum by (pod) (count_over_time({job=~\".+\", namespace=~\"$namespace\", pod!=\"\"} [$__range])))",
          "instant": true,
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": ["percent"]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "{pod=\"([^\"]+)\"}",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "$datasource"
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "{job=~\".+\", namespace=~\"$namespace\", pod=~\"$pod\", level=~\"$level\"} | json $search_filter",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Tenant",
        "query": "loki",
        "current": {},
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "$datasource"
        },
        "query": { "label": "namespace", "stream": "{job=~\".+\"}", "type": 1 },
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "$datasource"
        },
        "query": { "label": "pod", "stream": "{job=~\".+\", namespace=~\"$namespace\"}", "type": 1 },
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Level",
        "query": "critical,error,warn,info,debug,trace,unknown",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "critical", "value": "critical", "selected": false },
          { "text": "error", "value": "error", "selected": false },
          { "text": "warn", "value": "warn", "selected": false },
          { "text": "info", "value": "info", "selected": false },
          { "text": "debug", "value": "debug", "selected": false },
          { "text": "trace", "value": "trace", "selected": false },
          { "text": "unknown", "value": "unknown", "selected": false }
        ]
      },
      {
        "name": "search_filter",
        "type": "textbox",
        "label": "Search",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cluster Logs",
  "uid": "cluster-logs",
  "version": 2,
  "schemaVersion": 39
}
